# 🌸 Cherry Configuration Template
# Copy this file to .env on NAS and fill in your real values:
#   ssh rajat@192.168.29.101
#   cd /volume1/docker/cherry
#   cp .env.example .env
#   nano .env
#
# Required: OPENROUTER_API_KEY (get free at https://openrouter.ai/keys)

# ── OpenRouter (cloud LLM — primary) ──────────────────────────
OPENROUTER_API_KEY=sk-or-v1-PUT-YOUR-KEY-HERE
CHERRY_MODEL=minimax/minimax-m3:free
CHERRY_CODER_MODEL=minimax/minimax-m3:free

# ── Ollama (local LLM fallback) ────────────────────────────────
# On NAS with host network: Ollama runs on host → use localhost
# On laptop / Docker bridge: use host.docker.internal or LAN IP
OLLAMA_HOST=http://localhost:11434
# OLLAMA_HOST=http://host.docker.internal:11434  # Docker Desktop
# OLLAMA_HOST=http://192.168.29.101:11434         # LAN
# OLLAMA_HOST=http://100.98.94.128:11434          # Tailscale
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# ── NAS connection (for SSH / server ops) ──────────────────────
NAS_HOST=192.168.29.101
# NAS_HOST=100.98.94.128    # Tailscale (remote access)
NAS_USER=rajat
CHERRY_LOCAL=1              # 1 = run on NAS host, 0 = SSH to NAS

# ── Cherry server ──────────────────────────────────────────────
CHERRY_PORT=3003
CHERRY_HOST=0.0.0.0

# ── Optional: Telegram notifications ───────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=